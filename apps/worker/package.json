{
  "name": "@ecommerce/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: BullMQ consumers (email, marketing, reports, imports, media, maintenance)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@ecommerce/database": "workspace:*",
    "@ecommerce/email-templates": "workspace:*",
    "@ecommerce/types": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/bullmq": "^11.0.1",
    "bullmq": "^5.34.10",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@ecommerce/config": "workspace:*",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
