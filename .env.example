# =========================================================
#  Copy to .env (repo root). Every app and package reads it.
# =========================================================
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public

# ---------- Redis (cache + BullMQ queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect URI to register in Google Cloud: <API_PUBLIC_URL>/api/v1/auth/google/callback

# ---------- Email (the only notification channel) ----------
# Local dev uses Mailpit (docker compose): inbox at http://localhost:8025
MAIL_PROVIDER=smtp
MAIL_FROM="Ecommerce <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- Object storage (S3-compatible; MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecommerce-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_URL=http://localhost:9000/ecommerce-media
S3_FORCE_PATH_STYLE=true
# Creates the bucket + public-read policy on API start (development)
S3_AUTO_CREATE_BUCKET=true

# ---------- Payments ----------
# "mock" = test gateway page at /pay/mock/… (disabled in production unless PAYMENT_ALLOW_MOCK_IN_PRODUCTION=true).
# A real gateway is one adapter in apps/api/src/modules/payments/providers (see docs/architecture.md).
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-change-me
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
# Encrypts gateway credentials saved in Admin → Settings → Payments. Required in production; any long random string.
PAYMENT_ENCRYPTION_KEY=dev-only-change-me-to-a-long-random-string
# Stripe (used when the Stripe keys in Admin → Settings → Payments are empty; still enable Stripe there).
# Test keys: dashboard.stripe.com → Developers → API keys. Local webhooks: `stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:4000/api/v1/payments/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Support assistant (services/support-ai, Python) ----------
# Internal service: never expose it publicly; the API proxies it at /api/v1/support/assistant.
SUPPORT_AI_URL=http://localhost:5000
SUPPORT_AI_KEY=dev-support-ai-key-change-me
# The assistant's own tables (chats, knowledge base). Separate database, created on first start.
SUPPORT_AI_DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/support_ai
# Store lookups (orders, products). Empty = DATABASE_URL, always opened read-only.
# Production: point it at a read-only Postgres role.
STORE_DATABASE_URL=
# Empty = the store name from Admin → Settings.
STORE_NAME=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---------- Frontend apps ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_VENDOR_URL=http://localhost:3002

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
