{
  "name": "@ecommerce/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the shared Prisma client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma/seed.ts",
    "clean": "rimraf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:format": "prisma format",
    "db:validate": "dotenv -e ../../.env -- prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "seed:catalog": "tsx prisma/seed-catalog.ts",
    "seed:flow": "tsx prisma/seed-flow.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@ecommerce/config": "workspace:*",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "dotenv-cli": "^8.0.0",
    "argon2": "^0.41.1",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "@types/node": "^22.10.7"
  }
}
