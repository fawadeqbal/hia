// =====================================================================
//  E-Commerce Platform — Prisma schema (scope section 8)
//  Run: pnpm db:migrate   (creates a migration from this file)
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================== ENUMS ==============================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
  DELETED
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  VENDOR
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  WALLET
  BANK_TRANSFER
  COD
  GIFT_CARD
}

enum TransactionType {
  AUTHORIZE
  CAPTURE
  SALE
  REFUND
  VOID
}

enum ShippingRateType {
  FLAT
  WEIGHT_BASED
  PRICE_BASED
  FREE
  PICKUP
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEMS_RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionType {
  FLASH_SALE
  BUY_X_GET_Y
  TIERED
}

enum PointsTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ============================== IDENTITY ==============================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  googleId        String?    @unique
  locale          String     @default("en")
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles           UserRole[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  otpCodes        OtpCode[]
  addresses       Address[]
  ownedVendors    Vendor[]         @relation("VendorOwner")
  vendorStaff     VendorStaff[]
  cart            Cart?
  savedItems      SavedItem[]
  orders          Order[]
  reviews         Review[]
  questions       Question[]
  answers         Answer[]
  wishlists       Wishlist[]
  stockAlerts     StockAlert[]
  productViews    ProductView[]
  loyaltyAccount  LoyaltyAccount?
  referralsMade   Referral[]       @relation("Referrer")
  referredBy      Referral?        @relation("Referee")
  emailPreference EmailPreference?
  tickets         Ticket[]         @relation("TicketCustomer")
  assignedTickets Ticket[]         @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  disputes        Dispute[]
  returnRequests  ReturnRequest[]
  couponUsages    CouponUsage[]
  blogPosts       BlogPost[]
  auditLogs       AuditLog[]

  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "catalog.product.update"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Last time this device refreshed its tokens.
  lastUsedAt    DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Device session this token belongs to (rotated tokens share one session).
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  countryCode String   @db.Char(2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================== VENDORS ==============================

model Vendor {
  id                String       @id @default(cuid())
  ownerId           String
  name              String
  slug              String       @unique
  email             String
  phone             String?
  logoUrl           String?
  bannerUrl         String?
  description       String?      @db.Text
  policies          Json?
  status            VendorStatus @default(PENDING)
  statusReason      String?      @db.Text // why rejected / suspended (shown to the vendor)
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  iban              String?
  ratingAverage     Decimal      @default(0) @db.Decimal(3, 2)
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  owner           User             @relation("VendorOwner", fields: [ownerId], references: [id])
  staff           VendorStaff[]
  documents       VendorDocument[]
  products        Product[]
  vendorOrders    VendorOrder[]
  commissionRules CommissionRule[]
  payouts         Payout[]
  warehouses      Warehouse[]
  coupons         Coupon[]
  disputes        Dispute[]

  @@index([status])
}

model VendorStaff {
  id          String   @id @default(cuid())
  vendorId    String
  userId      String
  permissions String[]
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
}

model VendorDocument {
  id        String   @id @default(cuid())
  vendorId  String
  type      String
  fileUrl   String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model CommissionRule {
  id         String          @id @default(cuid())
  scope      CommissionScope
  vendorId   String?
  categoryId String?
  rate       Decimal         @db.Decimal(5, 2) // percentage
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Payout {
  id               String       @id @default(cuid())
  vendorId         String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal      @db.Decimal(12, 2)
  refundAmount     Decimal      @default(0) @db.Decimal(12, 2)
  netAmount        Decimal      @db.Decimal(12, 2)
  currency         String       @db.Char(3)
  status           PayoutStatus @default(PENDING)
  reference        String?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  vendor           Vendor       @relation(fields: [vendorId], references: [id])
  items            PayoutItem[]

  @@index([vendorId, status])
}

model PayoutItem {
  id            String      @id @default(cuid())
  payoutId      String
  vendorOrderId String      @unique
  amount        Decimal     @db.Decimal(12, 2)
  commission    Decimal     @db.Decimal(12, 2)
  net           Decimal     @db.Decimal(12, 2)
  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id])
}

// ============================== CATALOG ==============================

model Category {
  id             String   @id @default(cuid())
  parentId       String?
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  commissionRules CommissionRule[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id               String        @id @default(cuid())
  vendorId         String
  categoryId       String
  brandId          String?
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?       @db.Text
  specifications   Json?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  rejectionReason  String?       @db.Text // set when an admin rejects / unpublishes
  basePrice        Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("USD") @db.Char(3)
  taxClass         String?
  weightGrams      Int?
  videoUrl         String?
  seoTitle         String?
  seoDescription   String?
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  category      Category             @relation(fields: [categoryId], references: [id])
  brand         Brand?               @relation(fields: [brandId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  translations  ProductTranslation[]
  reviews       Review[]
  questions     Question[]
  wishlistItems WishlistItem[]
  views         ProductView[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status, isFeatured])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  name           String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  barcode        String?
  weightGrams    Int?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes     ProductVariantAttribute[]
  images         ProductImage[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]
  cartItems      CartItem[]
  savedItems     SavedItem[]
  orderItems     OrderItem[]
  stockAlerts    StockAlert[]

  @@index([productId])
}

model Attribute {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique // e.g. "color", "size"
  type         String           @default("select")
  isFilterable Boolean          @default(true)
  position     Int              @default(0)
  values       AttributeValue[]
}

model AttributeValue {
  id          String                    @id @default(cuid())
  attributeId String
  value       String
  label       String?
  swatch      String?
  position    Int                       @default(0)
  attribute   Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariantAttribute[]

  @@unique([attributeId, value])
}

model ProductVariantAttribute {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String
  name             String
  shortDescription String?
  description      String? @db.Text
  seoTitle         String?
  seoDescription   String?
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

// ============================== INVENTORY ==============================

model Warehouse {
  id          String          @id @default(cuid())
  vendorId    String?
  name        String
  code        String          @unique
  address     Json?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])
  stockLevels StockLevel[]
  movements   StockMovement[]
}

model StockLevel {
  id                String         @id @default(cuid())
  variantId         String
  warehouseId       String
  quantity          Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  warehouseId String
  type        StockMovementType
  quantity    Int
  reference   String?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

model StockReservation {
  id          String         @id @default(cuid())
  variantId   String
  warehouseId String?
  cartId      String?
  orderId     String?
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([expiresAt, releasedAt])
}

// ============================== CART ==============================

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionId  String?    @unique // guest carts
  currency   String     @default("USD") @db.Char(3)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model SavedItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

// ============================== ORDERS ==============================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  email           String
  status          OrderStatus   @default(PENDING_PAYMENT)
  currency        String        @db.Char(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  /// Part of taxTotal added on top of prices (exclusive rates); the rest was included in prices.
  taxAdded        Decimal       @default(0) @db.Decimal(12, 2)
  giftCardTotal   Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyDiscount Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  couponCode      String?
  shippingAddress Json
  billingAddress  Json?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  customerNote    String?
  idempotencyKey  String?       @unique
  placedAt        DateTime      @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user                 User?                 @relation(fields: [userId], references: [id])
  vendorOrders         VendorOrder[]
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  notes                OrderNote[]
  invoices             Invoice[]
  payments             Payment[]
  returnRequests       ReturnRequest[]
  couponUsages         CouponUsage[]
  giftCardTransactions GiftCardTransaction[]
  pointsTransactions   PointsTransaction[]
  disputes             Dispute[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model VendorOrder {
  id               String      @id @default(cuid())
  orderId          String
  vendorId         String
  status           OrderStatus @default(PENDING_PAYMENT)
  subtotal         Decimal     @db.Decimal(12, 2)
  shippingTotal    Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal     @default(0) @db.Decimal(12, 2)
  /// Part of taxTotal added on top of prices (exclusive rates); the rest was included in prices.
  taxAdded         Decimal     @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal     @default(0) @db.Decimal(12, 2)
  netAmount        Decimal     @default(0) @db.Decimal(12, 2)
  /// Snapshot of the delivery option chosen at checkout (rates can change or be deleted later).
  shippingRateId   String?
  shippingMethod   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  items         OrderItem[]
  shipments     Shipment[]
  statusHistory OrderStatusHistory[]
  payoutItem    PayoutItem?

  @@index([vendorId, status])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  vendorOrderId String
  variantId     String
  productName   String
  variantName   String?
  sku           String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  /// Rate snapshot (0.1800 = 18%), null = not taxed.
  taxRate       Decimal?       @db.Decimal(6, 4)
  /// true = tax was included in unitPrice; false = added on top.
  taxInclusive  Boolean        @default(false)
  taxName       String?
  total         Decimal        @db.Decimal(12, 2)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  returnItems   ReturnItem[]
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  vendorOrderId String?
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  changedById   String?
  createdAt     DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  /// Note about one seller's sub-order (sellers see only these); null = whole order (staff).
  vendorOrderId     String?
  authorId          String?
  content           String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorOrderId])
}

model Invoice {
  id       String   @id @default(cuid())
  orderId  String
  /// One invoice per seller sub-order (the seller is the seller of record).
  vendorOrderId String? @unique
  number   String   @unique
  fileUrl  String?
  total    Decimal  @db.Decimal(12, 2)
  issuedAt DateTime @default(now())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================== PAYMENTS ==============================

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  method       PaymentMethod
  provider     String
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @db.Char(3)
  providerRef  String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([providerRef])
}

model Transaction {
  id          String          @id @default(cuid())
  paymentId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  status      String
  providerRef String?
  raw         Json?
  createdAt   DateTime        @default(now())
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String         @id @default(cuid())
  paymentId       String
  returnRequestId String?
  amount          Decimal        @db.Decimal(12, 2)
  reason          String?
  status          PaymentStatus  @default(PENDING)
  providerRef     String?
  createdAt       DateTime       @default(now())
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

/// Online payment gateways (definitions live in code: PAYMENT_GATEWAYS in @ecommerce/types).
model PaymentGateway {
  code        String   @id
  isEnabled   Boolean  @default(false)
  isTestMode  Boolean  @default(true)
  /// Methods offered at checkout through this gateway (subset of the gateway's own methods).
  methods     String[]
  /// Lower = preferred. Checkout uses the first enabled gateway.
  position    Int      @default(0)
  /// AES-256-GCM encrypted JSON (key: PAYMENT_ENCRYPTION_KEY). Never returned by the API.
  credentials String?
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

// ============================== SHIPPING ==============================

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String[]
  regions   String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id             String           @id @default(cuid())
  zoneId         String
  courierId      String?
  name           String
  type           ShippingRateType
  price          Decimal          @db.Decimal(12, 2)
  minWeightGrams Int?
  maxWeightGrams Int?
  minOrderTotal  Decimal?         @db.Decimal(12, 2)
  maxOrderTotal  Decimal?         @db.Decimal(12, 2)
  freeAbove      Decimal?         @db.Decimal(12, 2)
  codAvailable   Boolean          @default(true)
  codFee         Decimal          @default(0) @db.Decimal(12, 2)
  estimatedDays  String?
  isActive       Boolean          @default(true)
  zone           ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  courier        Courier?         @relation(fields: [courierId], references: [id])
}

model Courier {
  id                  String         @id @default(cuid())
  name                String
  code                String         @unique
  apiConfig           Json?
  trackingUrlTemplate String?
  isActive            Boolean        @default(true)
  rates               ShippingRate[]
  shipments           Shipment[]
}

model Shipment {
  id             String         @id @default(cuid())
  vendorOrderId  String
  courierId      String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  labelUrl       String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendorOrder    VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  courier        Courier?       @relation(fields: [courierId], references: [id])

  @@index([trackingNumber])
}

// ============================== RETURNS ==============================

model ReturnRequest {
  id            String           @id @default(cuid())
  rmaNumber     String           @unique
  orderId       String
  userId        String?
  status        ReturnStatus     @default(REQUESTED)
  resolution    ReturnResolution @default(REFUND)
  reason        String
  comments      String?
  images        String[]
  refundAmount  Decimal?         @db.Decimal(12, 2)
  /// One return = items of one seller's sub-order (that seller handles it).
  vendorOrderId String?
  /// Why it was approved / rejected (shown to the customer).
  decisionNote  String?
  refundedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id])
  user          User?            @relation(fields: [userId], references: [id])
  items         ReturnItem[]
  refunds       Refund[]

  @@index([status])
  @@index([vendorOrderId])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  condition       String?
  restocked       Boolean       @default(false)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
}

// ============================== PROMOTIONS ==============================

model Coupon {
  id                    String        @id @default(cuid())
  code                  String        @unique
  description           String?
  discountType          DiscountType
  value                 Decimal       @db.Decimal(12, 2)
  minOrderTotal         Decimal?      @db.Decimal(12, 2)
  maxDiscount           Decimal?      @db.Decimal(12, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int           @default(0)
  stackable             Boolean       @default(false)
  vendorId              String?
  categoryIds           String[]
  productIds            String[]
  startsAt              DateTime?
  endsAt                DateTime?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  vendor                Vendor?       @relation(fields: [vendorId], references: [id])
  usages                CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Promotion {
  id        String        @id @default(cuid())
  name      String
  type      PromotionType
  rules     Json // conditions + rewards, interpreted by PromotionsModule
  priority  Int           @default(0)
  startsAt  DateTime
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GiftCard {
  id             String                @id @default(cuid())
  code           String                @unique
  initialBalance Decimal               @db.Decimal(12, 2)
  balance        Decimal               @db.Decimal(12, 2)
  currency       String                @db.Char(3)
  recipientEmail String?
  senderName     String?
  message        String?
  expiresAt      DateTime?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  transactions   GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  orderId    String?
  amount     Decimal  @db.Decimal(12, 2)
  type       String // ISSUE | REDEEM | REFUND | ADJUST
  createdAt  DateTime @default(now())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id])
}

// ============================== LOYALTY ==============================

model LoyaltyAccount {
  id             String              @id @default(cuid())
  userId         String              @unique
  points         Int                 @default(0)
  lifetimePoints Int                 @default(0)
  tierId         String?
  referralCode   String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           Tier?               @relation(fields: [tierId], references: [id])
  transactions   PointsTransaction[]
}

model PointsTransaction {
  id          String                @id @default(cuid())
  accountId   String
  type        PointsTransactionType
  points      Int
  orderId     String?
  description String?
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  account     LoyaltyAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order       Order?                @relation(fields: [orderId], references: [id])

  @@index([accountId, createdAt])
}

model Tier {
  id         String           @id @default(cuid())
  name       String           @unique
  minPoints  Int
  multiplier Decimal          @default(1) @db.Decimal(4, 2)
  benefits   Json?
  accounts   LoyaltyAccount[]
}

model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String    @unique
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())
  referrer   User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User      @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
}

// ============================== ENGAGEMENT ==============================

model Review {
  id           String           @id @default(cuid())
  productId    String
  userId       String
  orderItemId  String?
  rating       Int
  title        String?
  body         String?          @db.Text
  status       ModerationStatus @default(PENDING)
  vendorReply  String?
  helpfulCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       ReviewImage[]

  @@index([productId, status])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Question {
  id        String           @id @default(cuid())
  productId String
  userId    String
  body      String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String?
  isVendor   Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  name      String         @default("My Wishlist")
  isDefault Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  priceAtAdd Decimal? @db.Decimal(12, 2) // used for price-drop emails
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
}

model StockAlert {
  id         String         @id @default(cuid())
  variantId  String
  userId     String?
  email      String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

// ============================== CMS ==============================

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String
  locale         String        @default("en")
  content        Json // block-editor document
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([slug, locale])
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  placement      String // e.g. "home.hero", "home.mid", "category.top"
  position       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([placement, isActive])
}

model Menu {
  id     String     @id @default(cuid())
  name   String
  handle String     @unique // "header", "footer"
  items  MenuItem[]
}

model MenuItem {
  id       String     @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  url      String
  position Int        @default(0)
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemTree")
}

model BlogPost {
  id             String        @id @default(cuid())
  authorId       String?
  categoryId     String?
  title          String
  slug           String        @unique
  excerpt        String?
  content        Json
  coverImageUrl  String?
  tags           String[]
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         User?         @relation(fields: [authorId], references: [id])
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  category String?
  position Int     @default(0)
  isActive Boolean @default(true)
}

// ============================== NOTIFICATIONS (EMAIL) ==============================

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String // matches EmailTemplateKey in @ecommerce/types
  locale      String   @default("en")
  name        String
  subject     String
  previewText String?
  overrides   Json? // admin-editable content blocks
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
}

model EmailLog {
  id                String      @id @default(cuid())
  templateKey       String
  to                String
  subject           String?
  status            EmailStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  metadata          Json?
  userId            String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([to])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model EmailPreference {
  id             String    @id @default(cuid())
  userId         String    @unique
  marketing      Boolean   @default(true)
  productUpdates Boolean   @default(true)
  unsubscribedAt DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now())
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  userId         String?
  isConfirmed    Boolean   @default(false)
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([isConfirmed, unsubscribedAt])
}

/// Abandoned-cart email sequence progress per cart (reset when the customer changes the cart).
model CartRecovery {
  cartId        String   @id
  /// Emails sent so far in the sequence.
  step          Int      @default(0)
  /// Cart.updatedAt when the last email went out: a newer cart activity restarts the sequence.
  cartUpdatedAt DateTime
  lastSentAt    DateTime
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  subject     String
  templateKey String
  content     Json?
  segment     Json? // audience filter
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  stats       Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ============================== SUPPORT ==============================

model Ticket {
  id         String          @id @default(cuid())
  number     String          @unique
  customerId String?
  email      String
  subject    String
  status     TicketStatus    @default(OPEN)
  priority   TicketPriority  @default(MEDIUM)
  assigneeId String?
  orderId    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   User?           @relation("TicketCustomer", fields: [customerId], references: [id])
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages   TicketMessage[]

  @@index([status, priority])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String?
  body        String   @db.Text
  isInternal  Boolean  @default(false)
  attachments String[]
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?    @relation(fields: [authorId], references: [id])
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String
  vendorId   String
  customerId String
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id])
  vendor     Vendor        @relation(fields: [vendorId], references: [id])
  customer   User          @relation(fields: [customerId], references: [id])
}

// ============================== SYSTEM ==============================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  group     String   @default("general")
  value     Json
  updatedAt DateTime @updatedAt
}

model Currency {
  code         String  @id @db.Char(3)
  name         String
  symbol       String
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
}

model Language {
  code      String  @id
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  /// Right-to-left script (Urdu, Arabic).
  isRtl     Boolean @default(false)
}

model TaxRate {
  id          String  @id @default(cuid())
  name        String
  taxClass    String  @default("standard")
  countryCode String  @db.Char(2)
  region      String?
  rate        Decimal @db.Decimal(6, 4) // 0.1700 = 17%
  isInclusive Boolean @default(false)
  isActive    Boolean @default(true)

  @@index([countryCode, taxClass])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "order.status.update"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Media {
  id           String    @id @default(cuid())
  uploadedById String?
  type         MediaType
  url          String
  key          String    @unique // storage object key
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime  @default(now())
}
