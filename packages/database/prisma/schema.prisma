// =====================================================================
//  E-Commerce Platform — Prisma schema (scope section 8)
//  Run: pnpm db:migrate   (creates a migration from this file)
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================== ENUMS ==============================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
  DELETED
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  WALLET
  BANK_TRANSFER
  COD
}

enum TransactionType {
  AUTHORIZE
  CAPTURE
  SALE
  REFUND
  VOID
}

enum ShippingRateType {
  FLAT
  WEIGHT_BASED
  PRICE_BASED
  FREE
  PICKUP
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEMS_RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ============================== IDENTITY ==============================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  googleId        String?    @unique
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles           UserRole[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  otpCodes        OtpCode[]
  addresses       Address[]
  ownedVendors    Vendor[]         @relation("VendorOwner")
  cart            Cart?
  savedItems      SavedItem[]
  orders          Order[]
  reviews         Review[]
  questions       Question[]
  answers         Answer[]
  wishlists       Wishlist[]
  stockAlerts     StockAlert[]
  productViews    ProductView[]
  emailPreference EmailPreference?
  tickets         Ticket[]         @relation("TicketCustomer")
  assignedTickets Ticket[]         @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  returnRequests  ReturnRequest[]
  couponUsages    CouponUsage[]
  auditLogs       AuditLog[]

  @@index([status])
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id            String         @id @default(cuid())
  userId        String
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  /// Last time this device refreshed its tokens.
  lastUsedAt    DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Device session this token belongs to (rotated tokens share one session).
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  countryCode String   @db.Char(2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================== VENDORS ==============================

model Vendor {
  id         String       @id @default(cuid())
  ownerId    String
  name       String
  slug       String       @unique
  email      String
  status     VendorStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  owner        User          @relation("VendorOwner", fields: [ownerId], references: [id])
  products     Product[]
  vendorOrders VendorOrder[]
  warehouses   Warehouse[]

  @@index([status])
}

// ============================== CATALOG ==============================

model Category {
  id             String   @id @default(cuid())
  parentId       String?
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id               String        @id @default(cuid())
  vendorId         String
  categoryId       String
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?       @db.Text
  specifications   Json?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  basePrice        Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("USD") @db.Char(3)
  weightGrams      Int?
  videoUrl         String?
  seoTitle         String?
  seoDescription   String?
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  questions     Question[]
  wishlistItems WishlistItem[]
  views         ProductView[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status, isFeatured])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  name           String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  barcode        String?
  weightGrams    Int?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes     ProductVariantAttribute[]
  images         ProductImage[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]
  cartItems      CartItem[]
  savedItems     SavedItem[]
  orderItems     OrderItem[]
  stockAlerts    StockAlert[]

  @@index([productId])
}

model Attribute {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique // e.g. "color", "size"
  type         String           @default("select")
  isFilterable Boolean          @default(true)
  position     Int              @default(0)
  values       AttributeValue[]
}

model AttributeValue {
  id          String                    @id @default(cuid())
  attributeId String
  value       String
  label       String?
  swatch      String?
  position    Int                       @default(0)
  attribute   Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariantAttribute[]

  @@unique([attributeId, value])
}

model ProductVariantAttribute {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ============================== INVENTORY ==============================

model Warehouse {
  id          String          @id @default(cuid())
  vendorId    String?
  name        String
  code        String          @unique
  address     Json?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])
  stockLevels StockLevel[]
  movements   StockMovement[]
}

model StockLevel {
  id                String         @id @default(cuid())
  variantId         String
  warehouseId       String
  quantity          Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  warehouseId String
  type        StockMovementType
  quantity    Int
  reference   String?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

model StockReservation {
  id          String         @id @default(cuid())
  variantId   String
  warehouseId String?
  cartId      String?
  orderId     String?
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([expiresAt, releasedAt])
}

// ============================== CART ==============================

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionId  String?    @unique // guest carts
  currency   String     @default("USD") @db.Char(3)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model SavedItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

// ============================== ORDERS ==============================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  email           String
  status          OrderStatus   @default(PENDING_PAYMENT)
  currency        String        @db.Char(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  couponCode      String?
  shippingAddress Json
  billingAddress  Json?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  customerNote    String?
  idempotencyKey  String?       @unique
  placedAt        DateTime      @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user           User?                @relation(fields: [userId], references: [id])
  vendorOrders   VendorOrder[]
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  notes          OrderNote[]
  invoices       Invoice[]
  payments       Payment[]
  returnRequests ReturnRequest[]
  couponUsages   CouponUsage[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model VendorOrder {
  id             String      @id @default(cuid())
  orderId        String
  vendorId       String
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotal       Decimal     @db.Decimal(12, 2)
  shippingTotal  Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  /// Snapshot of the delivery option chosen at checkout (rates can change or be deleted later).
  shippingRateId String?
  shippingMethod String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  items         OrderItem[]
  shipments     Shipment[]
  statusHistory OrderStatusHistory[]

  @@index([vendorId, status])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  vendorOrderId String
  variantId     String
  productName   String
  variantName   String?
  sku           String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  returnItems   ReturnItem[]
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  vendorOrderId String?
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  changedById   String?
  createdAt     DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  authorId          String?
  content           String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String
  /// One invoice per seller sub-order (the seller is the seller of record).
  vendorOrderId String?  @unique
  number        String   @unique
  fileUrl       String?
  total         Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================== PAYMENTS ==============================

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  method       PaymentMethod
  provider     String
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @db.Char(3)
  providerRef  String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([providerRef])
}

model Transaction {
  id          String          @id @default(cuid())
  paymentId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  status      String
  providerRef String?
  raw         Json?
  createdAt   DateTime        @default(now())
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String         @id @default(cuid())
  paymentId       String
  returnRequestId String?
  amount          Decimal        @db.Decimal(12, 2)
  reason          String?
  status          PaymentStatus  @default(PENDING)
  providerRef     String?
  createdAt       DateTime       @default(now())
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

/// Online payment gateways (definitions live in code: PAYMENT_GATEWAYS in @ecommerce/types).
model PaymentGateway {
  code        String   @id
  isEnabled   Boolean  @default(false)
  isTestMode  Boolean  @default(true)
  /// Methods offered at checkout through this gateway (subset of the gateway's own methods).
  methods     String[]
  /// Lower = preferred. Checkout uses the first enabled gateway.
  position    Int      @default(0)
  /// AES-256-GCM encrypted JSON (key: PAYMENT_ENCRYPTION_KEY). Never returned by the API.
  credentials String?
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

// ============================== SHIPPING ==============================

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String[]
  regions   String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id             String           @id @default(cuid())
  zoneId         String
  courierId      String?
  name           String
  type           ShippingRateType
  price          Decimal          @db.Decimal(12, 2)
  minWeightGrams Int?
  maxWeightGrams Int?
  minOrderTotal  Decimal?         @db.Decimal(12, 2)
  maxOrderTotal  Decimal?         @db.Decimal(12, 2)
  freeAbove      Decimal?         @db.Decimal(12, 2)
  codAvailable   Boolean          @default(true)
  codFee         Decimal          @default(0) @db.Decimal(12, 2)
  estimatedDays  String?
  isActive       Boolean          @default(true)
  zone           ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  courier        Courier?         @relation(fields: [courierId], references: [id])
}

model Courier {
  id                  String         @id @default(cuid())
  name                String
  code                String         @unique
  apiConfig           Json?
  trackingUrlTemplate String?
  isActive            Boolean        @default(true)
  rates               ShippingRate[]
  shipments           Shipment[]
}

model Shipment {
  id             String         @id @default(cuid())
  vendorOrderId  String
  courierId      String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  labelUrl       String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendorOrder    VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  courier        Courier?       @relation(fields: [courierId], references: [id])

  @@index([trackingNumber])
}

// ============================== RETURNS ==============================

model ReturnRequest {
  id            String           @id @default(cuid())
  rmaNumber     String           @unique
  orderId       String
  userId        String?
  status        ReturnStatus     @default(REQUESTED)
  resolution    ReturnResolution @default(REFUND)
  reason        String
  comments      String?
  images        String[]
  refundAmount  Decimal?         @db.Decimal(12, 2)
  /// One return = items of one seller's sub-order (that seller handles it).
  vendorOrderId String?
  /// Why it was approved / rejected (shown to the customer).
  decisionNote  String?
  refundedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id])
  user          User?            @relation(fields: [userId], references: [id])
  items         ReturnItem[]
  refunds       Refund[]

  @@index([status])
  @@index([vendorOrderId])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  condition       String?
  restocked       Boolean       @default(false)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
}

// ============================== PROMOTIONS ==============================

model Coupon {
  id                    String        @id @default(cuid())
  code                  String        @unique
  description           String?
  discountType          DiscountType
  value                 Decimal       @db.Decimal(12, 2)
  minOrderTotal         Decimal?      @db.Decimal(12, 2)
  maxDiscount           Decimal?      @db.Decimal(12, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int           @default(0)
  categoryIds           String[]
  productIds            String[]
  startsAt              DateTime?
  endsAt                DateTime?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  usages                CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ============================== LOYALTY ==============================

// ============================== ENGAGEMENT ==============================

model Review {
  id           String           @id @default(cuid())
  productId    String
  userId       String
  orderItemId  String?
  rating       Int
  title        String?
  body         String?          @db.Text
  status       ModerationStatus @default(PENDING)
  helpfulCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model Question {
  id        String           @id @default(cuid())
  productId String
  userId    String
  body      String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String?
  body       String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  name      String         @default("My Wishlist")
  isDefault Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  priceAtAdd Decimal? @db.Decimal(12, 2) // used for price-drop emails
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
}

model StockAlert {
  id         String         @id @default(cuid())
  variantId  String
  userId     String?
  email      String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

// ============================== CMS ==============================

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  content        Json // block-editor document
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  placement      String // e.g. "home.hero", "home.mid", "category.top"
  position       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([placement, isActive])
}

model Menu {
  id     String     @id @default(cuid())
  name   String
  handle String     @unique // "header", "footer"
  items  MenuItem[]
}

model MenuItem {
  id       String     @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  url      String
  position Int        @default(0)
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemTree")
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  category String?
  position Int     @default(0)
  isActive Boolean @default(true)
}

// ============================== NOTIFICATIONS (EMAIL) ==============================

model EmailLog {
  id                String      @id @default(cuid())
  templateKey       String
  to                String
  subject           String?
  status            EmailStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  metadata          Json?
  userId            String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([to])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model EmailPreference {
  id             String    @id @default(cuid())
  userId         String    @unique
  marketing      Boolean   @default(true)
  productUpdates Boolean   @default(true)
  unsubscribedAt DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now())
}

// ============================== SUPPORT ==============================

model Ticket {
  id         String          @id @default(cuid())
  number     String          @unique
  customerId String?
  /// Contact details from the website inquiry form (Contact page). Email may be empty.
  name       String?
  phone      String?
  email      String
  /// REPAIR | QUOTE | GENERAL — InquiryTopic in packages/types/src/support/inquiry.ts
  topic      String          @default("GENERAL")
  subject    String
  status     TicketStatus    @default(OPEN)
  priority   TicketPriority  @default(MEDIUM)
  assigneeId String?
  orderId    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   User?           @relation("TicketCustomer", fields: [customerId], references: [id])
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages   TicketMessage[]

  @@index([status, priority])
  @@index([createdAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String?
  body        String   @db.Text
  isInternal  Boolean  @default(false)
  attachments String[]
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?    @relation(fields: [authorId], references: [id])
}

// ============================== SYSTEM ==============================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  group     String   @default("general")
  value     Json
  updatedAt DateTime @updatedAt
}

model Currency {
  code         String  @id @db.Char(3)
  name         String
  symbol       String
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "order.status.update"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Media {
  id           String    @id @default(cuid())
  uploadedById String?
  type         MediaType
  url          String
  key          String    @unique // storage object key
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime  @default(now())
}
